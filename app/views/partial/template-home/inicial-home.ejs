            <% }%>
    </section>

    <!-- FICHAS Recentes 2 -->
    <section class="cards__container mb-3 mt-3">
        <section class="cards__row">
            <% if(postagens && postagens.fichas && postagens.fichas.recentes) {
                postagens.fichas.recentes.forEach(function(ficha, index){ if(index> 4 && index < 8) {%>
                    <article class="card__ficha">
                        <a href="/view-ficha?idFicha=<%=ficha.ID_OBRA %>" class="card__content">
                            <img src="./img/imagens-servidor/capas-img/<%= ficha.CAMINHO_CAPA %>" alt="imagem da ficha">
                            <article class="card-title">
                                <h4 class="subtitle">
                                    <%=ficha.NOME_OBRA %>
                                </h4>
                            </article>
                        </a>
                        <footer class="card__autor">
                            <article class="usuario">
                                <img src="./img/imagens-servidor/perfil/<%= ficha.usuario.CAMINHO_FOTO%>"
                                    alt="imagem do autor">
                                <a href="/profile?idUser=<%=ficha.usuario.ID_USUARIO%>" class="smallText">
                                    <%= ficha.usuario.NICKNAME_USUARIO %>
                                </a>
                                <% if (ficha.usuario.ID_TIPO_USUARIO !=='undefined' && ficha.usuario.ID_TIPO_USUARIO
                                    !=null && ficha.usuario.ID_TIPO_USUARIO !=1 && ficha.usuario.ID_TIPO_USUARIO !=4)
                                    {%>
                                    <img src="./img/diversos/<%= ficha.usuario.ID_TIPO_USUARIO == 2 ? 'tripulante-icon.png' : 'comandante-icon.png' %>"
                                        alt="icone de assinante" class="icon-perfil">
                                    <% }%>
                            </article>
                            <p class="smallText">
                                <%= ficha.DATA_FICHA %>
                            </p>
                        </footer>
                    </article>
                    <% } }) } %>
        </section>
    </section>
    <!-- Resenhas recentes 2-->

    <section class="carousel__container mt-3 mb-3">
        <article class="arrows">
            <button class="arrow-btn previous"><i class="bi bi-arrow-left-short"></i></button>
            <button class="arrow-btn next"><i class="bi bi-arrow-right-short"></i></button>
        </article>
        <section class="carousel__inner">


            <% if(postagens && postagens.resenhas && postagens.resenhas.recentes) {
                postagens.resenhas.recentes.forEach(function(resenha, index){ if(index> 10 && index < 20) {%>
                    <article class="card">
                        <article class="card__resenha">
                            <header class="card__img">
                                <a href="view-resenha?idResenha=<%= resenha.ID_RESENHAS %>">
                                    <img class="img__resenha"
                                        src="./img/imagens-servidor/capas-img/<%= resenha.CAPA_CAMINHO %>"
                                        alt="imagem da resenha">
                                </a>
                                <article class="usuario">
                                    <img src="./img/imagens-servidor/perfil/<%=resenha.usuario.CAMINHO_FOTO %>"
                                        alt="imagem do autor">
                                    <a href="/profile?idUser=<%= resenha.usuario.ID_USUARIO%>" class="link">
                                        <%= resenha.usuario.NICKNAME_USUARIO %>

                                    </a>
                                    <% if (resenha.usuario.ID_TIPO_USUARIO !=='undefined' &&
                                        resenha.usuario.ID_TIPO_USUARIO !=null && resenha.usuario.ID_TIPO_USUARIO !=1 &&
                                        resenha.usuario.ID_TIPO_USUARIO !=4) {%>
                                        <img src="./img/diversos/<%= resenha.usuario.ID_TIPO_USUARIO == 2 ? 'tripulante-icon.png' : 'comandante-icon.png' %>"
                                            alt="icone de assinante" class="icon-perfil">
                                        <% }%>
                                </article>
                            </header>
                            <footer class="card__content">
                                <h5 class="link">
                                    <%= resenha.TITULO_RESENHA %>
                                </h5>
                                <p class="text mt-2">
                                    <%= resenha.DESCR_RESENHA.length> 120 ? resenha.DESCR_RESENHA.substring(0, 120) +
                                        '...' : resenha.DESCR_RESENHA %>
                                </p>
                                <a href="view-resenha?idResenha=<%= resenha.ID_RESENHAS %>" class="btn"><i
                                        class="bi bi-arrow-right-circle"></i></a>
                            </footer>
                        </article>
                    </article>

                    <%} }) } %>

        </section>
    </section>

    <section class="ad__section mt-3">
        <% if(anuncios) { let anuncio=anuncios[Math.floor(Math.random() * anuncios.length)] %>
            <img class="ad__img"
                src="./img/imagens-servidor/anuncios/anuncio-imagem/<%= anuncio.CAMINHO_IMAGEM_ANUNCIO%>"
                alt="imagem do anúncio">
            <header class="ad__header">
                <a href="<%= anuncio.LINK_ANUNCIO != null ? anuncio.LINK_ANUNCIO : '#' %>" class="ad__user link">
                    <img src="./img/imagens-servidor/anuncios/foto-patrocinador/<%= anuncio.CAMINHO_FOTO_PATROCINADOR%>"
                        alt="patrocinador" class="ad__user-img">
                    <p class="ad__user-name text"><span style="color: var(--cor-principal);">Patrocinador</span> - <%=
                            anuncio.NOME_PATROCINADOR %>
                    </p>
                </a>
                <a href="<%= anuncio.LINK_ANUNCIO != null ? anuncio.LINK_ANUNCIO : '#' %>" class="btn">Conheça</a>
            </header>
            <% }%>
    </section>
</section>