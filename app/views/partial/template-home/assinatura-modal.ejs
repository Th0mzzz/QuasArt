<script>

    

    document.getElementById('form-checkout').addEventListener('submit', async (event) => {
        event.preventDefault(); // Evita o envio normal do formulário

        const cardData = {
            cardNumber: document.getElementById('form-checkout__cardNumber').value,
            cardExpirationDate: document.getElementById('form-checkout__expirationDate').value,
            securityCode: document.getElementById('form-checkout__securityCode').value,
            cardholderName: document.getElementById('form-checkout__cardholderName').value,
            cardholderEmail: document.getElementById('form-checkout__cardholderEmail').value
        };

        try {
            const tokenResponse = await mp.card.createToken(cardData);
            const cardTokenId = tokenResponse.id; // Este é o token que você enviará para o servidor
            // Agora você pode enviar o cardTokenId para sua rota no servidor para criar a assinatura ou cobrança
        } catch (error) {
            console.error('Erro ao criar token:', error);
        }
    });




    document.getElementById('comandanteMensal').addEventListener('click', async () => {
        try {
            const response = await fetch('/criarComandanteMensal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plano: 'mensal' })
            });

            if (response.headers.get("content-type")?.includes("application/json")) {
                const data = await response.json();
                if (data.init_point) {
                    window.location.href = data.init_point;
                } else {
                    alert('Erro ao iniciar assinatura.');
                }
            } else {
                window.location.href = '/entrar';
            }
        } catch (error) {
            console.error('Erro:', error);
            alert('Erro ao processar assinatura.');
        }
    });

</script>

<script src="./js/abrirModal.js"></script>
<script>
    const options = document.querySelectorAll(".option")
    btnsOpenModal.forEach(btn => {

        btn.addEventListener("click", () => {
            options.forEach(option => {
                option.classList.remove("active")
                if (btn.classList.contains("tripulante-btn") && option.classList.contains("tripulante")) {
                    option.classList.add("active")
                } else if (btn.classList.contains("comandante-btn") && option.classList.contains("comandante")) {
                    option.classList.add("active")
                }
            })
        });

    });

</script>