<section class="assinatura__modal modal" id="assinaturaModal">
    <button class="closeBtn btn"><i class="bi bi-x-lg"></i></button>
    <section class="modal__content">
        <article class="option comandante">
            <h2 class="title">Comandante <span class="negrito-amarelo">PLUS+</span></h2>
            <form action="/criarComandante" method="post">
               <article class="input__container">
                <select name="plano" id="plano" class="select__control">
                    <option value="mensal" selected>Plano Mensal</option>
                    <option value="anual">Plano Anual</option>
                </select>
                <label for="plano">Escolha o plano</label>
               </article>
                <button type="submit" class="btn mt-3 submit">Assinar</button>
            </form>
        </article>
        <article class="option tripulante">
            <h2 class="title">Tripulante <span class="negrito-roxo">PLUS+</span></h2>
            <form action="/criarTripulante" method="post">
                <article class="input__container">
                 <select name="plano" id="plano" class="select__control">
                     <option value="mensal" selected>Plano Mensal</option>
                     <option value="anual">Plano Anual</option>
                 </select>
                 <label for="plano">Escolha o plano</label>
                </article>
                 <button type="submit" class="btn mt-3 submit">Assinar</button>
             </form>
        </article>
    </section>
</section>


<script src="./js/abrirModal.js"></script>
<script>
    const options = document.querySelectorAll(".option")
    btnsOpenModal.forEach(btn => {

        btn.addEventListener("click", () => {
            options.forEach(option => {
                option.classList.remove("active")
                if (btn.classList.contains("tripulante-btn") && option.classList.contains("tripulante")) {
                    option.classList.add("active")
                } else if (btn.classList.contains("comandante-btn") && option.classList.contains("comandante")) {
                    option.classList.add("active")
                }
            })
        });

    });

</script>